# --- Base de datos (Postgres, ej. Neon: https://neon.tech, capa gratuita) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Acceso al dashboard de revision ---
# Contraseña unica para entrar en /dashboard. Cambiala por algo fuerte.
DASHBOARD_PASSWORD="cambia-esto"
# Cadena aleatoria larga para firmar la cookie de sesion (openssl rand -hex 32)
SESSION_SECRET="cambia-esto-tambien"

# --- Rastreo de fuentes ---
# Margen de tiempo (ms) del rastreo completo. Cuando se agota, cada fuente deja
# de examinar items nuevos y el resto se recoge en la siguiente pasada, en vez
# de que Vercel corte la funcion a medias. Por defecto 200000 (200s), pensado
# para el maxDuration de 280s; bajalo a ~50000 si tu plan corta a los 60s.
# AGGREGATION_BUDGET_MS="200000"

# --- Cron de agregacion ---
# Header "Authorization: Bearer <CRON_SECRET>" que debe enviar el workflow
# de GitHub Actions para poder disparar /api/cron/fetch
CRON_SECRET="cambia-esto-tambien-2"

# --- Prueba del resumen semanal (opcional) ---
# Solo para el boton "Enviar prueba" de /dashboard/newsletter, que manda el
# correo a una direccion tuya para verlo en una bandeja real. El envio de
# verdad NO pasa por aqui: sale por Shopify Email, donde esta la lista de
# suscriptores. Sin esta clave el panel sigue funcionando y solo desaparece
# ese boton. Clave gratuita en https://resend.com
RESEND_API_KEY=""
# Remitente de la prueba. Por defecto usa el de serie de Resend
# (onboarding@resend.dev), que funciona sin verificar dominio pero solo deja
# enviar a la direccion con la que se creo la cuenta de Resend. Con
# hoolsbrand.com verificado en Resend puedes poner el tuyo:
# NEWSLETTER_TEST_FROM="The Away End <hola@hoolsbrand.com>"

# --- Shopify Admin API (tienda hoolsbrand.com) ---
# Dominio *.myshopify.com de la tienda (no el dominio publico)
SHOPIFY_STORE_DOMAIN="s001ux-0y.myshopify.com"
# Credenciales de una app creada en el Dev Dashboard de Shopify (Configuracion >
# Apps y canales de venta > Desarrollar apps > Dev Dashboard). Scopes necesarios:
# read_content, write_content, read_online_store_pages, write_online_store_pages,
# write_files (para subir fotos y videos desde el panel a los Archivos de la
# tienda; ver README "Fotos y videos: como se suben") y read_products (para que
# el resumen semanal saque la prenda y su PRECIO de la tienda; sin el se usa un
# catalogo fijo que envejece y el correo puede salir con un precio viejo).
# Se canjean por un access token de corta duracion en cada llamada (ver src/lib/shopify.ts).
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
# gid del blog donde se publican los articulos. La tienda ya tiene un blog
# "The Away End" (handle: the-away-end) listo para usarse:
SHOPIFY_BLOG_ID="gid://shopify/Blog/127456543059"
SHOPIFY_BLOG_HANDLE="the-away-end"
# Sufijo de plantilla con el que se publica cada articulo. Sin esto Shopify usa
# la plantilla de articulo de serie del tema (imagen destacada recortada a
# banner) en vez de la editorial de Hools. Dejalo vacio solo si quieres la de
# serie a proposito.
SHOPIFY_ARTICLE_TEMPLATE_SUFFIX="hools-editorial"
# Dominio publico de la tienda, usado para construir el enlace del articulo
# al postear en X (ej. https://www.hoolsbrand.com/blogs/the-away-end/mi-articulo)
SHOPIFY_PUBLIC_DOMAIN="www.hoolsbrand.com"
SHOPIFY_API_VERSION="2026-04"

# --- Traduccion/reescritura en español (Claude, Anthropic) ---
# Clave de https://console.anthropic.com — se usa para generar titular y
# resumen en español de España de cada noticia durante el rastreo.
ANTHROPIC_API_KEY=""

# --- X (Twitter) API v2 ---
# Cuenta de desarrollador en https://developer.x.com con permisos de
# lectura Y escritura, y una App con "User authentication" activada (OAuth 1.0a)
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
# Bearer Token (autenticacion solo de aplicacion) de la misma App de X, solo
# necesario si vas a anadir fuentes de tipo "Cuenta de X" en /dashboard/sources
# (lee la linea temporal de esa cuenta via API, consume saldo de pago por uso).
TWITTER_BEARER_TOKEN=""

# --- Instagram (Meta Graph API) ---
# Cuenta de Instagram Business/Creator vinculada a una app de Meta for
# Developers (caso de uso "Administrar mensajes y contenido en Instagram").
# Token de acceso generado en esa misma app (dura ~60 dias, hay que
# renovarlo periodicamente). Gratuito, sin planes de pago como en X.
INSTAGRAM_ACCESS_TOKEN=""
# Id numerico de la cuenta de Instagram Business (se ve en el propio panel
# de configuracion de la API de Instagram, junto al nombre de usuario).
INSTAGRAM_USER_ID=""

# --- Facebook (pagina de la marca, misma app de Meta) ---
# Id de la pagina de Facebook y token de acceso DE LA PAGINA (no el personal).
# Se obtienen en el Explorador de la API Graph; usa un token de larga
# duracion o el token de pagina, que no caduca si se genera desde uno largo.
FACEBOOK_PAGE_ID=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
