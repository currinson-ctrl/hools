{% comment %}
  HOOLS · AVÍSAME (lista de espera de un lanzamiento)

  Recoge nombre y correo de quien quiere que le avisen cuando salga algo.

  Es una ventana, no una franja. Metido en la home rompía el ritmo de la
  página: entre el hero y el carrusel aparecía un bloque de formulario que no
  pinta nada ahí si no lo has pedido. Ahora la sección no dibuja nada mientras
  está cerrada —un `<dialog>` sin abrir no ocupa— y se abre desde cualquier
  enlace que apunte a `#avisame`, que es lo que hace el botón del hero.

  Se usa `<dialog>` y no un div propio porque trae de serie lo que cuesta
  hacer bien a mano: se cierra con Escape, atrapa el foco dentro mientras está
  abierto y el resto de la página queda inerte para el lector de pantalla.

  NO usa ninguna app ni servicio externo: usa el formulario de cliente que trae
  Shopify (`{{ '{% form ' }}'customer' %}`). Cada envío crea un cliente en la
  tienda con la etiqueta que se configure abajo, así que la lista se filtra
  desde Clientes y se exporta o se segmenta sin depender de nadie.

  La casilla de consentimiento no es decorativa. El formulario de cliente marca
  al que lo envía como que acepta email marketing, y en España eso solo vale si
  te lo ha dicho él: la casilla es lo que lo convierte en un consentimiento y no
  en una suscripción a la fuerza. Por eso es obligatoria y por eso enlaza a la
  política de privacidad de la tienda. Si la quitas, quitas la cobertura legal,
  no un adorno.

  Al enviar, Shopify recarga la página entera y la ventana se cerraría con
  ella, dejando al que se acaba de apuntar sin saber si ha funcionado. Por eso
  el envío correcto se recuerda en `aviso_ok` y el script la vuelve a abrir con
  el acuse de recibo dentro.
{% endcomment %}

{%- liquid
  assign tag = section.settings.customer_tag | strip
  if tag == blank
    assign tag = 'aviso'
  endif
  assign aviso_ok = false
-%}

<dialog class="hools-aviso" id="avisame" aria-labelledby="avisame-titulo">
  <div class="hools-aviso__inner">

    <button
      class="hools-aviso__close"
      type="button"
      data-aviso-close
      aria-label="Cerrar"
    >&times;</button>

    {%- if section.settings.kicker != blank -%}
      <p class="hools-aviso__kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="hools-aviso__title" id="avisame-titulo">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- form 'customer', id: 'avisame-form', class: 'hools-aviso__form' -%}

      {%- if form.posted_successfully? -%}

        {%- assign aviso_ok = true -%}
        <p class="hools-aviso__ok">{{ section.settings.success_text }}</p>

      {%- else -%}

        {%- if section.settings.text != blank -%}
          <p class="hools-aviso__text">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="hools-aviso__error">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <input type="hidden" name="contact[tags]" value="{{ tag | escape }}">

        <div class="hools-aviso__fields">
          <label class="hools-aviso__label" for="avisame-nombre">Nombre</label>
          <input
            class="hools-aviso__input"
            id="avisame-nombre"
            type="text"
            name="contact[first_name]"
            autocomplete="given-name"
            placeholder="Tu nombre"
            required
          >

          <label class="hools-aviso__label" for="avisame-email">Correo</label>
          <input
            class="hools-aviso__input"
            id="avisame-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="tucorreo@ejemplo.com"
            required
          >
        </div>

        <label class="hools-aviso__consent" for="avisame-consent">
          <input id="avisame-consent" type="checkbox" required>
          <span>
            {{ section.settings.consent_text }}
            {%- if shop.privacy_policy != blank %}
              <a href="{{ shop.privacy_policy.url }}" target="_blank" rel="noopener">Política de privacidad</a>.
            {%- endif -%}
          </span>
        </label>

        <button class="hools-aviso__btn" type="submit">
          {{ section.settings.button_label }}
        </button>

      {%- endif -%}

    {%- endform -%}

  </div>
</dialog>

<script>
  (function () {
    var dlg = document.getElementById('avisame');
    if (!dlg) return;

    // Sin soporte de <dialog> no se secuestra el clic: el enlace salta al
    // ancla y la regla :target de la hoja de estilo la deja verse como un
    // bloque normal. Peor que la ventana, pero se puede rellenar.
    if (typeof dlg.showModal !== 'function') return;

    document.addEventListener('click', function (e) {
      if (!e.target || !e.target.closest) return;

      var abre = e.target.closest('a[href$="#avisame"], [data-aviso-open]');
      if (abre) {
        e.preventDefault();
        dlg.showModal();
        return;
      }

      if (e.target.closest('[data-aviso-close]')) dlg.close();
    });

    // Pinchar en el fondo cierra. El relleno vive en .hools-aviso__inner justo
    // para esto: así todo lo que rodea a la tarjeta es el propio <dialog> y el
    // clic se distingue del que cae dentro.
    dlg.addEventListener('click', function (e) {
      if (e.target === dlg) dlg.close();
    });

    {%- if aviso_ok %}
      dlg.showModal();
    {%- endif %}
  })();
</script>

<style>
  .hools-aviso{
    --hools-black:#151515;
    --hools-gold:#CCB229;
    --hools-serif:"Source Serif 4", Georgia, serif;
    --hools-sans:"Muli", system-ui, -apple-system, sans-serif;

    width:min(460px, calc(100vw - 32px));
    max-height:calc(100vh - 40px);
    margin:auto;
    padding:0;
    border:0;
    overflow:auto;

    background:{{ section.settings.bg_color }};
    color:{{ section.settings.text_color }};
    box-shadow:0 30px 80px rgba(0,0,0,.45);
  }

  .hools-aviso::backdrop{
    background:rgba(0,0,0,.62);
  }

  /* Reserva para navegadores sin <dialog>: el enlace salta al ancla y esto lo
     hace visible como bloque, en vez de dejar un botón que no hace nada. */
  .hools-aviso:target{ display:block; }

  .hools-aviso__inner{
    position:relative;
    padding:{{ section.settings.padding_top }}px 32px {{ section.settings.padding_bottom }}px;
    text-align:center;
  }

  .hools-aviso__close{
    position:absolute;
    top:10px;
    right:12px;
    width:36px;
    height:36px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:26px;
    line-height:1;
    color:inherit;
    background:none;
    border:0;
    opacity:.55;
    cursor:pointer;
  }

  .hools-aviso__close:hover{ opacity:1; }

  .hools-aviso__kicker{
    font-family:var(--hools-sans);
    font-size:11px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.16em;
    color:var(--hools-gold);
    margin:0 0 10px;
  }

  .hools-aviso__title{
    font-family:var(--hools-serif);
    font-weight:400;
    font-size:clamp(26px,4vw,34px);
    line-height:1.1;
    margin:0 0 14px;
  }

  .hools-aviso__text{
    font-family:var(--hools-sans);
    font-size:15px;
    line-height:1.6;
    opacity:.85;
    margin:0 0 24px;
  }

  .hools-aviso__fields{
    display:grid;
    gap:6px;
    text-align:left;
  }

  .hools-aviso__label{
    font-family:var(--hools-sans);
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.1em;
    opacity:.75;
  }

  .hools-aviso__label + .hools-aviso__input{ margin-bottom:14px; }

  .hools-aviso__input{
    font-family:var(--hools-sans);
    font-size:16px; /* por debajo de 16px iOS hace zoom al enfocar */
    padding:13px 14px;
    border:1px solid rgba(255,255,255,.28);
    background:rgba(255,255,255,.06);
    color:inherit;
    width:100%;
    box-sizing:border-box;
  }

  .hools-aviso__input::placeholder{ color:currentColor; opacity:.45; }

  .hools-aviso__input:focus{
    outline:2px solid var(--hools-gold);
    outline-offset:1px;
  }

  .hools-aviso__consent{
    display:flex;
    gap:10px;
    align-items:flex-start;
    text-align:left;
    font-family:var(--hools-sans);
    font-size:13px;
    line-height:1.45;
    opacity:.85;
    margin:14px 0 20px;
    cursor:pointer;
  }

  .hools-aviso__consent input{
    flex:0 0 auto;
    margin-top:3px;
    accent-color:var(--hools-gold);
  }

  .hools-aviso__consent a{ color:inherit; }

  .hools-aviso__btn{
    font-family:var(--hools-sans);
    font-size:12px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.12em;
    color:var(--hools-black);
    background:var(--hools-gold);
    border:0;
    padding:15px 28px;
    width:100%;
    cursor:pointer;
    transition:background .2s ease;
  }

  .hools-aviso__btn:hover{ background:#e0c433; }

  .hools-aviso__ok,
  .hools-aviso__error{
    font-family:var(--hools-sans);
    font-size:15px;
    line-height:1.6;
    margin:0;
    padding:16px 18px;
    text-align:left;
  }

  .hools-aviso__ok{
    background:rgba(204,178,41,.16);
    border-left:3px solid var(--hools-gold);
  }

  .hools-aviso__error{
    background:rgba(190,60,60,.18);
    border-left:3px solid #be3c3c;
    margin-bottom:18px;
  }

  .hools-aviso__error ul{ margin:0; padding-left:18px; }

  @media (max-width:640px){
    .hools-aviso__inner{ padding-left:20px; padding-right:20px; }
  }
</style>

{% schema %}
{
  "name": "Hools · Avísame",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Es una ventana emergente: no se ve en la página hasta que alguien pulsa un enlace que apunte a #avisame, como el botón del hero. Déjala en la plantilla aunque no la veas." },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "PRÓXIMAMENTE" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Sé el primero en saberlo" },
    { "type": "text", "id": "text", "label": "Texto", "default": "Déjanos tu nombre y tu correo y te avisamos en cuanto salgan los tres modelos nuevos. Sin spam." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "AVÍSAME" },
    { "type": "text", "id": "success_text", "label": "Mensaje al enviar", "default": "Hecho. Te escribimos en cuanto salgan, y no antes." },

    { "type": "header", "content": "Consentimiento" },
    { "type": "text", "id": "consent_text", "label": "Texto de la casilla", "default": "Acepto recibir el aviso por correo y he leído la", "info": "Detrás se añade el enlace a la política de privacidad de la tienda. La casilla es obligatoria: es lo que hace válido el consentimiento." },

    { "type": "header", "content": "Dónde acaban los datos" },
    { "type": "text", "id": "customer_tag", "label": "Etiqueta del cliente", "default": "aviso-nuevos-modelos", "info": "Cada envío crea un cliente con esta etiqueta. En Clientes, filtra por ella para ver la lista y exportarla. Cambia la etiqueta en cada lanzamiento para no mezclarlos." },

    { "type": "header", "content": "Aspecto" },
    { "type": "color", "id": "bg_color", "label": "Fondo", "default": "#213B2E" },
    { "type": "color", "id": "text_color", "label": "Texto", "default": "#F8F8F8" },
    { "type": "range", "id": "padding_top", "min": 20, "max": 80, "step": 4, "unit": "px", "label": "Espacio arriba", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 20, "max": 80, "step": 4, "unit": "px", "label": "Espacio abajo", "default": 40 }
  ],
  "presets": [
    { "name": "Hools · Avísame" }
  ]
}
{% endschema %}
