        "custom_liquid_x3g3q6": {
          "type": "custom_liquid",
          "name": "Compartir",
          "settings": {
            "custom_liquid": "<div class=\"hools-share-wrap\">\n  <button type=\"button\" class=\"hools-share-btn\">\n    <span aria-hidden=\"true\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\">\n        <path d=\"M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7\"\n              stroke=\"currentColor\" stroke-width=\"1.5\"/>\n        <path d=\"M12 16V4M12 4l-4 4M12 4l4 4\"\n              stroke=\"currentColor\" stroke-width=\"1.5\"/>\n      </svg>\n    </span>\n    <span>COMPARTE</span>\n  </button>\n\n  <div id=\"hools-share-panel\" class=\"hools-share-panel\" hidden>\n\n    <!-- COPIAR ENLACE -->\n    <div class=\"hools-share-url\">\n      <input\n        id=\"hools-share-input\"\n        type=\"text\"\n        readonly\n        value=\"{{ shop.url }}{{ product.url }}\"\n      >\n      <button type=\"button\" class=\"hools-copy-btn\" id=\"hools-copy-btn\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M9 9h10v12H9z\"\n                stroke=\"currentColor\" stroke-width=\"1.5\"/>\n          <path d=\"M5 15H4a1 1 0 0 1-1-1V4\n                   a1 1 0 0 1 1-1h10\n                   a1 1 0 0 1 1 1v1\"\n                stroke=\"currentColor\" stroke-width=\"1.5\"/>\n        </svg>\n      </button>\n    </div>\n\n    <!-- OPCIONES -->\n    <div class=\"hools-share-links\">\n\n      <!-- WHATSAPP · OUTLINE -->\n      <a class=\"hools-share-link\"\n         target=\"_blank\"\n         rel=\"noopener\"\n         href=\"https://wa.me/?text={{ product.title | append: ' — ' | append: shop.url | append: product.url | url_encode }}\">\n\n        <span class=\"hools-share-logo is-wa\" aria-hidden=\"true\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path\n              d=\"M12 3a9 9 0 0 0-7.9 13.3L3 21l4.8-1.1A9 9 0 1 0 12 3Z\"\n              stroke=\"currentColor\" stroke-width=\"1.5\"\n              stroke-linejoin=\"round\"/>\n            <path\n              d=\"M9.5 9.5c-.3.6-.8 1.1-.8 2 0 1.8 2.6 4.4 4.4 4.4.9 0 1.4-.5 2-0.8\n                 .3-.2.4-.4.3-.7l-.6-1.4c-.1-.3-.4-.3-.6-.2l-.7.4\n                 c-.2.1-.4.1-.6 0-1-.4-1.8-1.2-2.2-2.2\n                 -.1-.2-.1-.4 0-.6l.4-.7\n                 c.1-.2.1-.5-.2-.6l-1.4-.6\n                 c-.3-.1-.5 0-.7.3Z\"\n              stroke=\"currentColor\" stroke-width=\"1.5\"\n              stroke-linecap=\"round\"\n              stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n\n        <span>WHATSAPP</span>\n      </a>\n\n      <!-- TELEGRAM · OUTLINE -->\n      <a class=\"hools-share-link\"\n         target=\"_blank\"\n         rel=\"noopener\"\n         href=\"https://t.me/share/url?url={{ shop.url | append: product.url | url_encode }}&text={{ product.title | url_encode }}\">\n\n        <span class=\"hools-share-logo is-tg\" aria-hidden=\"true\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\">\n            <path\n              d=\"M21 4 3 11.2l6.5 2.5 2.5 6.8\n                 3.5-4.5 4.6 3.3\n                 c.6.4 1.4.1 1.6-.7L23 5.5\n                 c.2-.9-.6-1.7-1.5-1.5Z\"\n              stroke=\"currentColor\" stroke-width=\"1.5\"\n              stroke-linejoin=\"round\"/>\n            <path\n              d=\"M9.5 13.7 18.5 7.5\"\n              stroke=\"currentColor\" stroke-width=\"1.5\"\n              stroke-linecap=\"round\"/>\n          </svg>\n        </span>\n\n        <span>TELEGRAM</span>\n      </a>\n\n    </div>\n\n    <div class=\"hools-share-toast\" id=\"hools-share-toast\" hidden>\n      Enlace copiado.\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .hools-share-wrap{ margin-top:16px; }\n\n  .hools-share-btn{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    background:none;\n    border:0;\n    padding:0;\n    cursor:pointer;\n    color:#151515;\n    text-transform:uppercase;\n    font-size:13px;\n    letter-spacing:.08em;\n  }\n\n  .hools-share-panel{\n    margin-top:12px;\n    border:1px solid rgba(21,21,21,.18);\n    padding:14px;\n    max-width:520px;\n    background:#F8F8F8;\n  }\n\n  .hools-share-url{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    border:1px solid rgba(21,21,21,.18);\n    background:#fff;\n    padding:10px;\n  }\n\n  #hools-share-input{\n    flex:1;\n    border:0;\n    outline:0;\n    background:transparent;\n    font-size:18px;\n  }\n\n  .hools-copy-btn{\n    background:none;\n    border:0;\n    cursor:pointer;\n    padding:6px;\n  }\n\n  .hools-share-links{\n    display:flex;\n    gap:22px;\n    margin-top:12px;\n    text-transform:uppercase;\n    font-size:13px;\n    letter-spacing:.06em;\n  }\n\n  .hools-share-link{\n    display:flex;\n    align-items:center;\n    gap:10px;\n    text-decoration:none;\n    color:#151515;\n  }\n\n  /* CAJA ICONO */\n  .hools-share-logo{\n    width:18px;\n    height:18px;\n    display:inline-flex;\n    align-items:center;\n    justify-content:center;\n    line-height:0;\n  }\n\n  /* AJUSTE ÓPTICO */\n  .hools-share-logo.is-wa svg{ transform: translateY(-1px); }\n  .hools-share-logo.is-tg svg{ transform: translateY(-1px); }\n\n  .hools-share-toast{\n    margin-top:12px;\n    font-size:12px;\n    text-transform:uppercase;\n    letter-spacing:.08em;\n    color:rgba(21,21,21,.7);\n  }\n</style>\n\n<script>\n(() => {\n  const wrap = document.querySelector('.hools-share-wrap');\n  if(!wrap) return;\n\n  const btn = wrap.querySelector('.hools-share-btn');\n  const panel = wrap.querySelector('#hools-share-panel');\n  const input = wrap.querySelector('#hools-share-input');\n  const copyBtn = wrap.querySelector('#hools-copy-btn');\n  const toast = wrap.querySelector('#hools-share-toast');\n\n  btn.addEventListener('click', () => {\n    panel.hidden = !panel.hidden;\n  });\n\n  copyBtn.addEventListener('click', async () => {\n    try{\n      await navigator.clipboard.writeText(input.value);\n    }catch(e){\n      input.select();\n      document.execCommand('copy');\n    }\n    toast.hidden = false;\n    setTimeout(() => toast.hidden = true, 1400);\n  });\n\n  document.addEventListener('click', (e) => {\n    if(!wrap.contains(e.target)) panel.hidden = true;\n  });\n})();\n</script>"
