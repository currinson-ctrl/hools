    "custom_liquid_6fc6jc": {
      "type": "custom-liquid",
      "name": "banner",
      "settings": {
        "custom_liquid": "{%- comment -%}\nHOOLS — Thin Banner (Custom Liquid)\nTexto y botón desplazados hacia el centro\n{%- endcomment -%}\n\n<div class=\"hools-thin-banner\"\n  style=\"\n    --bg-url: url('https://cdn.shopify.com/s/files/1/0988/6364/5011/files/hools-banner-grada-retro-attitude.png?v=1770302489');\n    --h-desktop: 160px;\n    --h-mobile: 140px;\n    --overlay: 0.35;\n    --text: #F8F8F8;\n    --gold: #CCB229;\n    --black: #151515;\n  \"\n>\n  <div class=\"hools-thin-banner__bg\">\n    <div class=\"hools-thin-banner__content\">\n\n      <div class=\"hools-thin-banner__left\">\n        <div class=\"hools-thin-banner__title\">\n          not a fashion... it's an attitude\n        </div>\n      </div>\n\n      <div class=\"hools-thin-banner__right\">\n        <a class=\"hools-thin-banner__btn\" href=\"/collections/productos\">\n          Comprar ahora\n        </a>\n      </div>\n\n    </div>\n  </div>\n</div>\n\n<style>\n/* =========================\n   HOOLS — Thin Banner\n   ========================= */\n\n.hools-thin-banner{\n  width: 100%;\n  margin: 30px 0;\n}\n\n.hools-thin-banner__bg{\n  position: relative;\n  width: 100%;\n  height: var(--h-desktop);\n  background-image: var(--bg-url);\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  overflow: hidden;\n}\n\n.hools-thin-banner__bg::before{\n  content:\"\";\n  position:absolute;\n  inset:0;\n  background: rgba(0,0,0,var(--overlay));\n  z-index: 1;\n}\n\n/* CONTENIDO — aquí está la clave */\n.hools-thin-banner__content{\n  position: relative;\n  z-index: 2;\n  height: 100%;\n\n  max-width: 980px;        /* ⬅️ REDUCE el ancho para acercar al centro */\n  margin: 0 auto;\n  padding: 0 24px;\n\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n}\n\n/* TEXTO */\n.hools-thin-banner__title{\n  font-family: 'Source Serif 4', Georgia, serif;\n  font-weight: 400;\n  letter-spacing: .3px;\n  color: var(--text);\n  font-size: 35px;\n  line-height: 1.1;\n  margin: 0;\n  text-align: left;\n}\n\n/* BOTÓN SÓLIDO */\n.hools-thin-banner__btn{\n  display: inline-block;\n  padding: 12px 26px;\n  background: var(--gold);\n  color: var(--black);\n  border: none;\n  text-decoration: none;\n  font-size: 14px;\n  letter-spacing: .6px;\n  transition: background .2s ease;\n  white-space: nowrap;\n}\n\n.hools-thin-banner__btn:hover{\n  background: #bfa51f;\n}\n\n/* =========================\n   RESPONSIVE\n   ========================= */\n@media (max-width: 768px){\n\n  .hools-thin-banner__bg{\n    height: var(--h-mobile);\n  }\n\n  .hools-thin-banner__content{\n    flex-direction: column;\n    justify-content: center;\n    text-align: center;\n  }\n\n  .hools-thin-banner__title{\n    font-size: 18px;\n    text-align: center;\n  }\n}\n</style>",
